{
  "manifest_version": 3,
  "name": "Sony LIV TMKOC Storyline Scraper",
  "version": "1.0",
  "description": "One-click Chrome extension to extract all TMKOC episode descriptions and synopses from Sony LIV for storylines.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.sonyliv.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sony LIV TMKOC Scraper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sonyliv.com/*"],
      "js": ["content.js"]
    }
  ]
}
